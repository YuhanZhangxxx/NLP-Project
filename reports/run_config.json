{
  "random_seed": 42,
  "tfidf": {
    "ngram": [
      1,
      2
    ],
    "min_df": 2,
    "max_df": 0.9
  },
  "nb": {
    "alpha": 1.0
  },
  "lr": {
    "C": 1.0,
    "max_iter": 200
  },
  "splits": {
    "train": "data/processed/train.txt",
    "valid": "data/processed/valid.txt",
    "test": "data/processed/test.txt"
  },
  "labels_order": [
    "bad",
    "good"
  ]
}